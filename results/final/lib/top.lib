          values("0.01781,0.02058,0.02791,0.04571,0.09385,0.24218,0.69523");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.16241");
	}
	fall_constraint(scalar) {
          values("0.12517");
	}
      }
      timing() {
        related_pin : "clk";
