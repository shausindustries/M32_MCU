	cell_fall(scalar) {
          values("0.64379");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.64788");
	}
	cell_fall(scalar) {
          values("0.64230");
	}
      }
      timing() {
        timing_sense : negative_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.06934");
	}
	cell_fall(scalar) {
          values("1.06171");
	}
      }
    }
    pin("of") {
      direction : output;
